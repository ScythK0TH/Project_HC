// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model users {
  id        String      @id
  username  String      @unique
  password  String
  createdAt DateTime @default(now())
}

model carts {
  cid       BigInt         @id   @default(autoincrement() || sequence())
  id        String
  pid       Int
  pcolor    String
  quantity   Int
}

model products {
  id          Int       @id
  name        String
  price       Int
  description String
  img         String
  imageid     Int
  manufact    String
  stock       Int
}

model history {
  id        Int         @id   @default(autoincrement() || sequence())
  uid       String
  pid       Int
  pcolor    String
  quantity  Int
  price     Int
  BuyAt     DateTime @default(now())
}

model product_colors {
  id        Int         @id   @default(autoincrement() || sequence())
  pid       Int
  pcolor    String
}
